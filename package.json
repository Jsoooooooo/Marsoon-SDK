{
  "name": "@cdjustin/chart-sdk",
  "version": "0.2.0",
  "description": "Marsoon A-share chart SDK with built-in AppKey authorization",
  "license": "UNLICENSED",
  "keywords": [
    "chart",
    "finance",
    "trading",
    "wasm"
  ],
  "type": "module",
  "main": "./runtime/marsoon-chart.js",
  "types": "./runtime/marsoon-chart.d.ts",
