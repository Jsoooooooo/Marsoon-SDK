    "runtime/marsoon-chart-runtime-*.js",
    "runtime/marsoon-chart-runtime-*_bg.wasm"
  ],
  "homepage": "https://github.com/Jsoooooooo/Marsoon-SDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jsoooooooo/Marsoon-SDK.git"
  },
  "publishConfig": {
